# LLM provider used by the intent parser and code generation.
# Supported: groq, gemini, openai, openrouter, deepseek
LLM_PROVIDER=groq

# Groq API key (or GEMINI_API_KEY / OPENAI_API_KEY for other providers).
GROQ_API_KEY=your-groq-api-key-here
CODING_AGENT_INTENT_MODEL=llama-3.3-70b-versatile

# Gemini API key. Optional: when set, the agent automatically falls back to
# Gemini if the primary provider fails (e.g. Groq rate limits).
GEMINI_API_KEY=your-gemini-api-key-here
# CODING_AGENT_GEMINI_MODEL=gemini-2.0-flash

# OpenRouter API key. Optional: used as a final fallback if both the primary
# provider and Gemini fail. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here
# CODING_AGENT_OPENROUTER_MODEL=openrouter/auto
# Free model (no credits needed) — the free lineup rotates, verify with:
#   curl -H "Authorization: Bearer $OPENROUTER_API_KEY" https://openrouter.ai/api/v1/models
# CODING_AGENT_OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# DeepSeek API key. Optional: used as a fallback tier and can be set as the
# primary via LLM_PROVIDER=deepseek. DeepSeek is OpenAI-compatible and very
# cheap. Get a key at https://platform.deepseek.com/
DEEPSEEK_API_KEY=your-deepseek-api-key-here
# CODING_AGENT_DEEPSEEK_MODEL=deepseek-chat

# Maximum tokens requested per LLM call. Keep this well under your remaining
# credit balance; OpenRouter rejects requests whose max_tokens it cannot
# reserve (e.g. its 65536 default when this is unset).
# CODING_AGENT_MAX_TOKENS=2048

# GitHub personal access token for GitHub integration (optional).
GITHUB_TOKEN=your-github-pat-here

# PostgreSQL database for agent memory storage.
# Start with: docker-compose up -d
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/coding_agent

# Daytona sandbox key (optional). When set, code runs in a remote Daytona sandbox
# instead of locally.
DAYTONA_API_KEY=your-daytona-api-key
# DAYTONA_API_URL=https://app.daytona.io/api

# ── LangGraph Runtime ───────────────────────────────────────────────
# Set to "true" to use the new LangGraph runtime (default: true).
# Set to "false" to use the legacy CodingAgent runtime.
# CODING_AGENT_USE_GRAPH=true

# Maximum repair attempts before giving up (default: 3).
# CODING_AGENT_MAX_REPAIR_ATTEMPTS=3

# LLM provider for the graph runtime. Default: openrouter.
# Supported: openrouter, openai, anthropic
# CODING_AGENT_LLM_PROVIDER=openrouter

# ── LangSmith Observability ────────────────────────────────────────
# LangSmith API key for tracing, debugging, and evaluation.
# Get a key at https://smith.langchain.com/settings
LANGSMITH_API_KEY=your-langsmith-api-key-here

# Enable LangSmith tracing (required for traces to be recorded).
LANGCHAIN_TRACING_V2=true

# LangSmith project name for grouping traces.
LANGCHAIN_PROJECT=coding-agent
