# LLM provider used by the intent parser and code generation.
LLM_PROVIDER=groq

# Groq API key (or GEMINI_API_KEY / OPENAI_API_KEY for other providers).
GROQ_API_KEY=your-groq-api-key-here
CODING_AGENT_INTENT_MODEL=llama-3.3-70b-versatile

# Gemini API key. Optional: when set, the agent automatically falls back to
# Gemini if the primary provider fails (e.g. Groq rate limits).
GEMINI_API_KEY=your-gemini-api-key-here
# CODING_AGENT_GEMINI_MODEL=gemini-2.0-flash

# OpenRouter API key. Optional: used as a final fallback if both the primary
# provider and Gemini fail. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here
# CODING_AGENT_OPENROUTER_MODEL=openrouter/auto

# GitHub personal access token for GitHub integration (optional).
GITHUB_TOKEN=your-github-pat-here

# Chroma Cloud credentials for vector memory.
CHROMA_TENANT=your-chroma-tenant
CHROMA_DATABASE=your-chroma-database
CHROMA_API_KEY=your-chroma-api-key

# Daytona sandbox key (optional). When set, code runs in a remote Daytona sandbox
# instead of locally.
DAYTONA_API_KEY=your-daytona-api-key
# DAYTONA_API_URL=https://app.daytona.io/api
